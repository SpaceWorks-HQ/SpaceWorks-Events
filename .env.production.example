# Space Works Events: production on free-tier cloud services.
# Render (app) + Supabase (Postgres) + Upstash (Redis) + Cloudflare R2
# (object storage) + Brevo (SMTP) + a Cloudflare Worker (cron).
# Full walkthrough: docs/DEPLOYMENT_CLOUD.md
#
# These are placeholders. Enter real values in the Render Dashboard (or your
# secrets manager), never in a committed file. Check a filled-in copy with:
#   node --env-file=/secure/path/swevents.env scripts/check-production-env.mjs

NODE_ENV=production

# --- Public origin ---------------------------------------------------------
# Both must be the same HTTPS origin, with no trailing slash. Use the custom
# domain, or https://<service-name>.onrender.com until you have one.
# NEXT_PUBLIC_BASE_URL is compiled into the build: changing it needs a redeploy.
AUTH_URL="https://events.YOUR-DOMAIN"
NEXT_PUBLIC_BASE_URL="https://events.YOUR-DOMAIN"
# The only account allowed into /super-admin (enrol authenticator MFA first).
SUPER_ADMIN_EMAIL="you@YOUR-DOMAIN"

# --- Supabase Postgres -------------------------------------------------------
# Supabase Dashboard > your project > Connect (top bar) > "Connection string".
# Runtime: the Transaction pooler (port 6543). pgbouncer=true is required
# (no prepared statements through the pooler); connection_limit caps Prisma's
# pool on the single 512 MB instance.
DATABASE_URL="postgresql://postgres.PROJECT-REF:DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Migrations: the Session pooler (port 5432). Use this rather than the "Direct
# connection" host db.PROJECT-REF.supabase.co, which is IPv6-only on the free
# plan and unreachable from Render.
DIRECT_URL="postgresql://postgres.PROJECT-REF:DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Apply migrations when the container starts (Render free has no pre-deploy).
MIGRATE_ON_START="1"
# Keep the Node.js heap inside the 512 MB instance.
NODE_OPTIONS="--max-old-space-size=384"

# --- Upstash Redis -----------------------------------------------------------
# Upstash Console > Redis > your database > "Connect" > ioredis / TLS URL.
# Must start with rediss:// (TLS). Used for rate limiting and live ticket
# check-in pub/sub.
REDIS_URL="rediss://default:UPSTASH-PASSWORD@YOUR-DB.upstash.io:6379"

# --- Secrets -----------------------------------------------------------------
# Render's Blueprint generates AUTH_SECRET, CRON_SECRET and HEALTHCHECK_SECRET.
# Otherwise generate each separately with:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"
# Bearer secret for POST /api/internal/outbox. The Cloudflare Worker needs the
# same value (wrangler secret put CRON_SECRET).
CRON_SECRET="CHANGE_ME"
# Bearer secret for GET /api/health/db.
HEALTHCHECK_SECRET="CHANGE_ME"
# Must be base64 of exactly 32 bytes:  openssl rand -base64 32
# Keep both in a password manager. NEXT_SERVER_ACTIONS_ENCRYPTION_KEY is also
# used at build time (rotating it means a redeploy). Losing MFA_ENCRYPTION_KEY
# makes every enrolled authenticator unusable.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="CHANGE_ME"
MFA_ENCRYPTION_KEY="CHANGE_ME"

# --- Client IP trust ---------------------------------------------------------
# x-forwarded-for: browsers reach Render directly (onrender.com, or a custom
#                  domain set to "DNS only" in Cloudflare).
# cf-connecting-ip: your Cloudflare zone proxies the domain (orange cloud).
TRUSTED_PROXY_IP_HEADER="x-forwarded-for"
# Render appends to X-Forwarded-For: read the right-most entry its proxy added.
TRUSTED_PROXY_HOPS="1"
# Leave empty unless a proxy serves Server Actions from another hostname.
ALLOWED_ACTION_ORIGINS=""
ALLOWED_EMBED_ORIGINS=""

# --- Cloudflare R2 (S3-compatible, keep the bucket PRIVATE) -------------------
# Cloudflare Dashboard > R2 > Create bucket (no public access, no custom domain).
# R2 > Manage API tokens > Create API token: "Object Read & Write", scoped to
# this bucket only. Copy the Access Key ID, Secret Access Key, and the
# S3 endpoint https://ACCOUNT-ID.r2.cloudflarestorage.com.
S3_BUCKET="spaceworks-events"
S3_REGION="auto"
S3_ENDPOINT="https://ACCOUNT-ID.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="R2-ACCESS-KEY-ID"
S3_SECRET_ACCESS_KEY="R2-SECRET-ACCESS-KEY"
S3_FORCE_PATH_STYLE="1"

# --- Brevo SMTP --------------------------------------------------------------
# Brevo > Settings > SMTP & API > SMTP tab: the login (e.g. 123abc001@smtp-brevo.com)
# and a generated SMTP key. Authenticate your sending domain first (Brevo >
# Senders, domains & dedicated IPs > Domains) so SPF, DKIM and DMARC pass.
# Port 2525 with STARTTLS: Render's free plan blocks outbound 25, 465 and 587.
# (Use 587 on hosts that allow it.) These are the bootstrap/fallback values;
# Super admin > Settings can take over SMTP later.
EMAIL_FROM="Space Works Events <events@YOUR-DOMAIN>"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER="YOUR-LOGIN@smtp-brevo.com"
SMTP_PASSWORD="BREVO-SMTP-KEY"

# --- Optional ----------------------------------------------------------------
OUTBOX_RETENTION_DAYS="30"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
